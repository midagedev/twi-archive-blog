---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type RelatedPost = {
	title: string;
	description: string;
	pubDate: Date;
	url: string;
	tags: string[];
	reasons: string[];
};

type Props = CollectionEntry<'blog'>['data'] & {
	relatedPosts?: RelatedPost[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	thumbnail,
	originalTweetUrl,
	source = 'note',
	tags = [],
	relatedPosts = [],
} = Astro.props;

const embedTweetUrl = originalTweetUrl?.replace(/^https:\/\/x\.com\//, 'https://twitter.com/');
---

<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage ?? thumbnail}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={updatedDate?.toISOString()}
		/>
		<style>
			.wrap {
				max-width: var(--max-prose);
				margin: 0 auto;
			}
			.hero-image {
				margin-bottom: 1.2rem;
			}
			.hero-image img {
				width: 100%;
				border-radius: 14px;
				border: 1px solid var(--line);
			}
			.meta-row {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.55rem;
				margin: 0.4rem 0 0.9rem;
			}
			.meta-row .dot {
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: var(--ink-faint);
			}
			.title h1 {
				margin: 0 0 1rem;
				line-height: 1.28;
				font-size: clamp(1.4rem, 3.6vw, 1.85rem);
			}
			.tags {
				display: flex;
				gap: 0.35rem;
				flex-wrap: wrap;
				margin-bottom: 1.4rem;
			}
			.prose {
				color: var(--ink-dim);
				font-size: 1.02rem;
			}
			.prose :global(a) {
				color: var(--accent);
				text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
			}
			.prose :global(p.tweet-image-row) {
				margin: 1rem 0;
			}
			.prose :global(p.tweet-image-row > img.tweet-image-inline) {
				display: block;
				width: 100%;
				max-width: 480px;
				height: auto;
				margin: 0;
				border: 1px solid var(--line);
				border-radius: 10px;
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 1.5em;
			}
			.prose :global(h3) {
				font-size: 0.82rem;
				font-family: var(--font-mono);
				font-weight: 600;
				color: var(--ink-faint);
				letter-spacing: 0.08em;
			}
			.divider {
				border: 0;
				border-top: 1px solid var(--line);
				margin: 1.6rem 0;
			}
			.tweet-preview {
				margin-top: 2rem;
				padding-top: 1.2rem;
				border-top: 1px solid var(--line);
				max-width: 100%;
				overflow-x: hidden;
			}
			.tweet-preview p {
				margin: 0 0 0.55rem;
			}
			.tweet-preview :global(.twitter-tweet),
			.tweet-preview :global(iframe) {
				max-width: 100% !important;
			}
			.related-notes {
				margin-top: 2.4rem;
			}
			.related-notes h2 {
				font-size: 0.78rem;
				font-family: var(--font-mono);
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--ink-faint);
				margin: 0 0 0.8rem;
			}
			.related-list {
				display: grid;
				gap: 0.65rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.related-link {
				display: grid;
				gap: 0.3rem;
				padding: 0.9rem 1rem;
				border: 1px solid var(--line);
				border-radius: 11px;
				background: var(--surface);
				text-decoration: none;
				transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
			}
			.related-link:hover {
				transform: translateY(-1px);
				border-color: var(--line-strong);
				box-shadow: var(--shadow);
			}
			.related-meta {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin: 0;
			}
			.related-title {
				margin: 0;
				font-size: 0.96rem;
				line-height: 1.4;
				color: var(--ink);
			}
			.related-link:hover .related-title {
				color: var(--accent);
			}
			.related-description {
				margin: 0;
				font-size: 0.87rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="wrap">
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<p class="meta-row mono">
					<FormattedDate date={pubDate} />
					<span class="dot" aria-hidden="true"></span>
					<span>{source}</span>
					{updatedDate && (
						<>
							<span class="dot" aria-hidden="true"></span>
							<span>updated <FormattedDate date={updatedDate} /></span>
						</>
					)}
				</p>
				<div class="title">
					<h1>{title}</h1>
				</div>
				{tags.length > 0 && (
					<div class="tags">
						{tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)}
				<hr class="divider" />
				<div class="prose">
					<slot />
				</div>
				{
					embedTweetUrl && (
						<div class="tweet-preview">
							<p class="mono">원문 미리보기</p>
							<blockquote class="twitter-tweet" data-dnt="true">
								<a href={embedTweetUrl}>{embedTweetUrl}</a>
							</blockquote>
							<script is:inline>
								if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
									document.querySelector('.twitter-tweet')?.setAttribute('data-theme', 'dark');
								}
							</script>
							<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
						</div>
					)
				}
				{
					relatedPosts.length > 0 && (
						<section class="related-notes" aria-labelledby="related-notes-title">
							<h2 id="related-notes-title">Related Notes</h2>
							<ul class="related-list">
								{relatedPosts.map((post) => (
									<li>
										<a class="related-link" href={post.url}>
											<p class="related-meta mono">
												<FormattedDate date={post.pubDate} />
												{post.tags.slice(0, 3).map((tag) => (
													<span>{tag}</span>
												))}
											</p>
											<h3 class="related-title">{post.title}</h3>
											<p class="related-description">{post.description}</p>
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
