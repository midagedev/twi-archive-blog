---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, X_URL } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				max-width: 40rem;
				margin: 1.2rem 0 2.4rem;
			}
			.hero-eyebrow {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.7rem;
			}
			.hero h1 {
				font-size: clamp(1.7rem, 5vw, 2.4rem);
				line-height: 1.22;
				margin-bottom: 0.8rem;
			}
			.hero p {
				margin: 0 0 1.1rem;
				font-size: 1.02rem;
				color: var(--ink-dim);
			}
			.hero-links {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.hero-links a {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				padding: 0.42rem 0.8rem;
				border-radius: 999px;
				border: 1px solid var(--line);
				background: var(--surface);
				color: var(--ink-dim);
				text-decoration: none;
				transition: border-color 140ms ease, color 140ms ease;
			}
			.hero-links a:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.8rem;
				margin-bottom: 1rem;
				border-top: 1px solid var(--line);
				padding-top: 1.2rem;
			}
			.section-head h2 {
				margin: 0;
				font-size: 1.05rem;
			}
			@media (max-width: 760px) {
				.hero {
					margin: 0.6rem 0 1.7rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="hero-eyebrow">Engineering Notes</p>
				<h1>실무 판단을 짧은 노트로 보존합니다</h1>
				<p>{SITE_DESCRIPTION}</p>
				<div class="hero-links">
					<a href={X_URL} target="_blank" rel="noreferrer">x.com/midagedev</a>
					<a href="https://github.com/midagedev" target="_blank" rel="noreferrer">github.com/midagedev</a>
					<a href="/rss.xml">rss</a>
				</div>
			</section>
			<div class="section-head">
				<h2>최근 노트</h2>
				<span class="mono">{posts.length} notes</span>
			</div>
			<ul class="feed">
				{posts.map((post) => (
					<li><PostCard post={post} /></li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
