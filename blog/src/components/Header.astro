---
import { SITE_TITLE, X_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="links">
			<HeaderLink href="/blog">Notes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a class="x-link" href={X_URL} target="_blank" rel="noreferrer" aria-label="X @midagedev">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
				</svg>
				<span class="handle">@midagedev</span>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 0.6rem 1.25rem;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		max-width: var(--max-content);
		margin: 0 auto;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		font-weight: 760;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand-mark {
		width: 9px;
		height: 9px;
		border-radius: 2.5px;
		background: var(--accent);
		flex: none;
		transform: rotate(45deg);
		transition: transform 300ms ease;
	}
	.brand:hover .brand-mark {
		transform: rotate(225deg);
	}
	.links {
		display: flex;
		gap: 0.15rem;
		align-items: center;
		min-width: 0;
	}
	.links :global(a) {
		padding: 0.36rem 0.6rem;
		color: var(--ink-dim);
		text-decoration: none;
		border-radius: 0.55rem;
		font-size: 0.88rem;
		white-space: nowrap;
	}
	.links :global(a:hover) {
		color: var(--ink);
		background: var(--surface-dim);
	}
	.links :global(a.active) {
		color: var(--accent);
		background: var(--accent-soft);
		font-weight: 650;
	}
	.x-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-left: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.78rem !important;
		border: 1px solid var(--line);
		background: var(--surface);
	}
	@media (max-width: 560px) {
		header {
			padding: 0.55rem 0.85rem;
		}
		.handle {
			display: none;
		}
		.x-link {
			padding: 0.42rem 0.5rem;
		}
	}
</style>
