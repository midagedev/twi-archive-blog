---
import type { CollectionEntry } from 'astro:content';
import { dedupeDescription, getPostUrl } from '../utils/postSlug';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const description = dedupeDescription(post.data.title, post.data.description);
---

<article class="card">
	{post.data.thumbnail && (
		<img class="thumb" src={post.data.thumbnail} alt="" loading="lazy" decoding="async" />
	)}
	<p class="meta mono">
		<FormattedDate date={post.data.pubDate} />
		<span class="dot" aria-hidden="true"></span>
		<span>{post.data.source ?? 'note'}</span>
	</p>
	<h2 class="title">
		<a class="stretch" href={getPostUrl(post)}>{post.data.title}</a>
	</h2>
	{description && <p class="desc">{description}</p>}
	{post.data.tags.length > 0 && (
		<p class="tags">
			{post.data.tags.slice(0, 4).map((tag) => (
				<a class="tag" href={`/tags/${tag}/`}>{tag}</a>
			))}
		</p>
	)}
</article>

<style>
	.card {
		position: relative;
		min-width: 0;
		padding: 1.15rem 1.2rem 1.05rem;
		border-radius: 14px;
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: var(--shadow);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
	}
	.card:hover {
		transform: translateY(-2px);
		border-color: var(--line-strong);
		box-shadow: var(--shadow-lift);
	}
	/* 카드 전체를 클릭 영역으로 (태그 링크는 z-index로 위에) */
	.stretch {
		color: inherit;
		text-decoration: none;
	}
	.stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 9px;
		border: 1px solid var(--line);
		background: var(--surface-dim);
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}
	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--ink-faint);
		flex: none;
	}
	.title {
		margin: 0;
		color: var(--ink);
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.42;
		letter-spacing: -0.008em;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card:hover .title {
		color: var(--accent);
	}
	.desc {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--ink-dim);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.tags {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
		margin: 0.15rem 0 0;
		padding-top: 0.35rem;
	}
	.tags a {
		text-decoration: none;
	}
	.tags a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
