---
import { X_URL } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-wrap">
		<p class="copyright mono">&copy; {today.getFullYear()} Midage Dev Notes</p>
		<p class="small">
			X에 남긴 실무 판단을 선별해 보존하는 엔지니어링 노트.
			<a href={X_URL} target="_blank" rel="noreferrer">@midagedev</a>
			· <a href="https://github.com/midagedev" target="_blank" rel="noreferrer">GitHub</a>
			· <a href="/rss.xml">RSS</a>
		</p>
	</div>
</footer>

<style>
	footer {
		padding: 2.5rem 1.25rem 4rem;
		color: var(--ink-dim);
	}
	.footer-wrap {
		max-width: var(--max-content);
		margin: 0 auto;
		border-top: 1px solid var(--line);
		padding-top: 1.2rem;
	}
	.copyright {
		margin: 0;
	}
	.small {
		font-size: 0.9rem;
		margin: 0.4rem 0 0;
	}
	.small a {
		font-weight: 650;
	}
</style>
